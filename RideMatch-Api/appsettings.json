{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionString": {
    "RideMatchDB": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=RideMatch;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "AppConfiguration": {
    "CurrentEnv": "local",
    "JWTIssuer": "RideMatch",
    "JWTKey": "development-only-change-this-secret-key-1234567890",
    "JWTAudience": "RideMatchClient",
    "JWTExpiresIn": 30, // mins
    "EnableSwagger": true
  },
  "Matching": {
    "InitialRadiusKm": 5,
    "RadiusIncrementKm": 5,
    "MaxRadiusKm": 20,
    "MaxCandidates": 10,
    "DriverLocationExpirySeconds": 30
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}

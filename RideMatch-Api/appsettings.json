{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "RideMatchDB": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=RideMatch;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "RideMatch",
    "Audience": "RideMatchClient",
    "ExpirationMinutes": 30
  },
  "Matching": {
    "InitialRadiusKm": 5,
    "RadiusIncrementKm": 5,
    "MaxRadiusKm": 20,
    "MaxCandidates": 10,
    "DriverLocationExpirySeconds": 30
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
